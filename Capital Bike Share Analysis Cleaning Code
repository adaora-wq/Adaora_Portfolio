# Converting temperature from Fahrenheight to Celsius #
SELECT *,
    temp AS temp_celsius,
    ROUND((temp * 1.8) + 32, 1) AS temp_fahrenheit
FROM `capstone1-506616.Bikeshare.BS1`;
