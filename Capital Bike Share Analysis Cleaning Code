#Finally to get a clear and cleaned table I ran this code:#
CREATE TABLE `capstone1-506616.Bikeshare.BS1_cleaned_V2` AS
SELECT 
  datetime,
  count,
  rain_1h,
  clouds_all,
  snow_1h,
  temp AS temp_celsius,
  ROUND((temp * 1.8) + 32, 1) AS temp_fahrenheit,
  ROUND((temp_min * 1.8) + 32, 1) AS temp_min_f,
  ROUND((temp_max * 1.8) + 32, 1) AS temp_max_f,
  ROUND((feels_like * 1.8) + 32, 1) AS feels_like_f,
  pressure,
  humidity,
  wind_speed,
  wind_deg,
  weather_main,
    # Int to str and null to int#
   CASE 
        WHEN holiday = 1 THEN 'Yes'
        WHEN holiday = 0 THEN 'No'
        ELSE 'No'
    END AS holiday_clean,
    
    CASE 
        WHEN workingday = 1 THEN 'Yes'
        WHEN workingday = 0 THEN 'No'
        ELSE 'No'
    END AS workingday_clean,
    CASE 
        WHEN rain_1h IS NULL THEN '0'
    END AS rain_clean,
    CASE 
        WHEN snow_1h IS NULL THEN '0'
    END AS snow_clean,
    #temperature categories#
    CASE 
        WHEN (temp * 1.8) + 32 < 40 THEN 'Cold (<40°F)'
        WHEN (temp * 1.8) + 32 BETWEEN 40 AND 60 THEN 'Cool (40-60°F)'
        WHEN (temp * 1.8) + 32 BETWEEN 61 AND 80 THEN 'Warm (61-80°F)'
        ELSE 'Hot (>80°F)'
    END AS categorized_temp
FROM `capstone1-506616.Bikeshare.BS1`;
SELECT *,
CASE 
        WHEN (temp_min * 1.8) + 32 < 40 THEN 'Cold (<40°F)'
        WHEN (temp_min * 1.8) + 32 BETWEEN 40 AND 60 THEN 'Cool (40-60°F)'
        WHEN (temp_min * 1.8) + 32 BETWEEN 61 AND 80 THEN 'Warm (61-80°F)'
        ELSE 'Hot (>80°F)'
    END AS categorized_temp_min
FROM `capstone1-506616.Bikeshare.BS1`;
SELECT *,
CASE 
        WHEN (temp_max * 1.8) + 32 < 40 THEN 'Cold (<40°F)'
        WHEN (temp_max * 1.8) + 32 BETWEEN 40 AND 60 THEN 'Cool (40-60°F)'
        WHEN (temp_max * 1.8) + 32 BETWEEN 61 AND 80 THEN 'Warm (61-80°F)'
        ELSE 'Hot (>80°F)'
    END AS categorized_temp_max,
    
    #date extraction#
    EXTRACT(YEAR FROM datetime) AS year,
    EXTRACT(MONTH FROM datetime) AS month,
    EXTRACT(DOW FROM datetime) AS day_of_week,
    EXTRACT(DOY FROM datetime) AS day_of_year,
    
    #weekday or weekend#
    CASE 
        WHEN EXTRACT(DOW FROM date) IN (0, 6) THEN 'Weekend'
        ELSE 'Weekday'
    END AS type_of_day,
CASE 
        WHEN rain_1h IS NULL THEN '0'
    END AS rain_clean,
    CASE 
        WHEN snow_1h IS NULL THEN '0'
    END AS snow_clean,
FROM `capstone1-506616.Bikeshare.BS1`

