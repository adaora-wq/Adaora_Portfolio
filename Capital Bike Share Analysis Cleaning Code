    temp_min AS temp_min_celsius,
    ROUND((temp_min * 1.8) + 32, 1) AS temp_min_fahrenheit
FROM `capstone1-506616.Bikeshare.BS1`;
SELECT 
    temp_max AS temp_max_celsius,
    ROUND((temp_max * 1.8) + 32, 1) AS temp_max_fahrenheit
FROM `capstone1-506616.Bikeshare.BS1`;
SELECT
    feels_like AS feels_like_celsius,
    ROUND((feels_like * 1.8) + 32, 1) AS feels_like_fahrenheit
FROM `capstone1-506616.Bikeshare.BS1`;

#Categorizing temperature#
SELECT *,
CASE 
        WHEN (temp * 1.8) + 32 < 40 THEN 'Cold (<40°F)'
        WHEN (temp * 1.8) + 32 BETWEEN 40 AND 60 THEN 'Cool (40-60°F)'
        WHEN (temp * 1.8) + 32 BETWEEN 61 AND 80 THEN 'Warm (61-80°F)'
        ELSE 'Hot (>80°F)'
    END AS categorized_temp
FROM `capstone1-506616.Bikeshare.BS1`;
SELECT *,
CASE 
        WHEN (temp_min * 1.8) + 32 < 40 THEN 'Cold (<40°F)'
        WHEN (temp_min * 1.8) + 32 BETWEEN 40 AND 60 THEN 'Cool (40-60°F)'
        WHEN (temp_min * 1.8) + 32 BETWEEN 61 AND 80 THEN 'Warm (61-80°F)'
        ELSE 'Hot (>80°F)'
    END AS categorized_temp_min
FROM `capstone1-506616.Bikeshare.BS1`;
SELECT *,
CASE 
        WHEN (temp_max * 1.8) + 32 < 40 THEN 'Cold (<40°F)'
        WHEN (temp_max * 1.8) + 32 BETWEEN 40 AND 60 THEN 'Cool (40-60°F)'
        WHEN (temp_max * 1.8) + 32 BETWEEN 61 AND 80 THEN 'Warm (61-80°F)'
        ELSE 'Hot (>80°F)'
